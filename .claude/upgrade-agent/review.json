      "Bash(git -C * config*)",
      "Bash(git remote*)",
      "Bash(git -C * remote*)",
      "Bash(git add*)",
      "Bash(git -C * add*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "Bash(git *-c *)",
      "Bash(task *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(ansible*)",
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(vagrant *)",
      "Bash(*/.env*)",
      "Read(**/.env)",
