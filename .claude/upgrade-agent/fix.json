{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": [
        "~/.git-credentials",
        "~/.kube",
        "~/.ssh",
        "~/.claude/.credentials.json",
        "~/.config",
        "~/.netrc",
        "~/.docker",
        "~/.gnupg",
        "~/.vault-token",
        "~/.ansible",
        "/home/sm/src/ops/.env",
        "/home/sm/src/infra/.env",
        "/home/sm/src/platform/.env",
        "~/.pgpass",
        "/home/sm/src/ops/deploy/ansible/vars/sealed-secrets-key-backup.yaml",
        "/home/sm/src/ops/vault-recovery"
      ]
    },
    "network": {
      "allowedDomains": [
        "code.forgejo.org",
        "download.pytorch.org",
        "download.sonatype.com",
        "get.helm.sh",
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "releases.hashicorp.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Edit(./infra/**)",
      "Edit(./platform/**)",
      "Edit(./ops/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:codeberg.org)",
      "Skill(upgrade-fix)",
      "Bash(cd ops)",
      "Bash(cd ..)",
      "Bash(python3 -I scripts/renovate-checksums.py --changed --base origin/main)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(cd infra)",
      "Bash(cd platform)"
    ],
    "deny": [
      "Edit(**/.git/**)",
      "WebSearch",
      "Read(~/.git-credentials)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.vault-token)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(task *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(ansible*)",
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(git *--no-index*)",
      "Bash(git *-c *)",
      "Bash(git *--exec-path*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git fetch*)",
      "Bash(git -C * fetch*)",
      "Bash(git pull*)",
      "Bash(git -C * pull*)",
      "Bash(git clone*)",
      "Bash(git -C * clone*)",
      "Bash(git checkout*)",
      "Bash(git -C * checkout*)",
      "Bash(git switch*)",
      "Bash(git -C * switch*)",
      "Bash(git branch*)",
      "Bash(git -C * branch*)",
      "Bash(git remote*)",
      "Bash(git -C * remote*)",
      "Bash(git reset*)",
      "Bash(git -C * reset*)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)",
      "Bash(git merge*)",
      "Bash(git -C * merge*)",
      "Bash(git config*)",
      "Bash(git -C * config*)",
      "Bash(git tag*)",
      "Bash(git -C * tag*)",
      "Bash(git worktree*)",
      "Bash(git -C * worktree*)",
      "Bash(git submodule*)",
      "Bash(git -C * submodule*)",
      "Bash(git update-ref*)",
      "Bash(git -C * update-ref*)",
      "Bash(git symbolic-ref*)",
      "Bash(git -C * symbolic-ref*)",
      "Bash(vagrant *)",
      "Read(//home/sm/src/ops/.env)",
      "Read(//home/sm/src/infra/.env)",
      "Read(//home/sm/src/platform/.env)",
      "Read(~/.pgpass)"
    ]
  }
}
