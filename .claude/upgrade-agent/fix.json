{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "WebFetch",
      "Skill(upgrade-fix)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch origin main)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git -C infra *)",
      "Bash(git -C platform *)",
      "Bash(git -C ops *)",
      "Bash(cd infra)",
      "Bash(cd platform)",
      "Bash(cd ops)",
      "Bash(cd ..)",
      "Bash(python3 -I scripts/renovate-checksums.py --changed --base origin/main)",
      "Bash(vagrant status*)",
      "Bash(vagrant ssh *)"
    ],
    "deny": [
      "Bash(git merge*)",
      "Bash(git -C * merge*)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)",
      "Bash(git reset*)",
      "Bash(git -C * reset*)",
      "Bash(git remote*)",
      "Bash(git -C * remote*)",
      "Bash(git config*)",
      "Bash(git -C * config*)",
      "Bash(git checkout main*)",
      "Bash(git -C * checkout main*)",
      "Bash(git switch main*)",
      "Bash(git -C * switch main*)",
      "Bash(git *-c *)",
      "Bash(git *--exec-path*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *push * *)",
      "Bash(git *push *--force*)",
      "Bash(git *push *-f*)",
      "Bash(git *push *+*)",
      "Bash(git *push *--delete*)",
      "Bash(git *push *--mirror*)",
      "Bash(git *push *--all*)",
      "Bash(git *push *--tags*)",
      "Bash(git *push *main*)",
      "Bash(git -C infra push *)",
      "Bash(git -C platform push *)",
      "Bash(git -C ops push *)",
      "Bash(task *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(ansible*)",
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(vagrant destroy*)",
      "Bash(vagrant halt*)",
      "Bash(vagrant up*)",
      "Bash(vagrant reload*)",
      "Bash(*/.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/**)"
    ]
  }
}
