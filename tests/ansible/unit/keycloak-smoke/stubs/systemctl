#!/bin/bash
# systemctl show -p MainPID --value keycloak: 41 while this Pi runs Keycloak, else 0 - any other call not stood in for
[ "$*" = "show -p MainPID --value keycloak" ] || { echo "systemctl stub: '$*' not stood in for" >&2; exit 1; }
[ -n "$(cat "$KCS/$KC_HOST/running" 2> /dev/null)" ] && echo 41 || echo 0
