# Environment for running production's Vault seeding (playbooks/seed-vault-secrets.yml) against the VAGRANT Pi
# Vault in the upgrade test. Test-only values, like the credential fixtures in inventory/vagrant.yml; nothing here
# is a production secret. Values the Vagrant stack wires up repeat the inventory's (backup store, Forgejo, Keycloak);
# every external service gets a dead-end placeholder, so nothing in the VMs can reach or spend on a real account.

# Vagrant Pi backup store (inventory: backup_root_user / backup_root_password)
BACKUP_ACCESS_KEY=velero-admin
BACKUP_SECRET_KEY=vagrant-minio-pw
MINIO_ROOT_USER=velero-admin
MINIO_ROOT_PASSWORD=vagrant-minio-pw

# Vagrant Forgejo on pi1 (inventory: forgejo_admin_*)
FORGEJO_ADMIN_USER=forgejo_admin
FORGEJO_ADMIN_PASSWORD=vagrant-forgejo-pw
FORGEJO_ADMIN_EMAIL=admin@pmon.dev
FORGEJO_READONLY_TOKEN=vagrant-not-a-token

# Vagrant Keycloak on pi1 (inventory: keycloak_admin_password, postgres_admin_password)
KEYCLOAK_ADMIN_PASSWORD=vagrant-keycloak-pw
KEYCLOAK_DB_PASSWORD=vagrant-pg-pw
KEYCLOAK_ARGOCD_CLIENT_SECRET=vagrant-argocd-oidc-secret
KEYCLOAK_FORGEJO_CLIENT_SECRET=vagrant-forgejo-oidc-secret
KEYCLOAK_ADMIN_SERVICE_CLIENT_SECRET=vagrant-admin-service-secret
KEYCLOAK_K6_SMOKE_CLIENT_SECRET=vagrant-k6-smoke-secret
KEYCLOAK_KAGENT_UI_CLIENT_SECRET=vagrant-not-used

# a valid KRaft cluster id (22 chars, a base64url UUID); fixed so a re-seed keeps the same cluster
KAFKA_CLUSTER_ID=bi2aUhscT2OaSno8XwueIQ

# internal to the cluster
GRAFANA_ADMIN_PASSWORD=vagrant-grafana-pw
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=vagrant-grafana-oidc-secret
ALERTMANAGER_WEBHOOK_SECRET=vagrant-alertmanager-webhook
PROMETHEUS_AUTH_TOKEN=vagrant-prometheus-token
SONARQUBE_ADMIN_PASSWORD=vagrant-sonarqube-pw
SONARQUBE_POSTGRES_PASSWORD=vagrant-sonarqube-pg-pw
SONARQUBE_TOKEN=vagrant-not-a-token

# external services: dead ends (an AI key that is not one; mail, DNS, webhooks and CI tokens that are not valid)
ANTHROPIC_API_KEY=vagrant-not-a-key
MASI_ANTHROPIC_API_KEY=
MAIL_PASSWORD=vagrant-not-a-key
RESEND_API_KEY=vagrant-not-a-key
RESEND_WEBHOOK_SECRET=vagrant-not-a-secret
PORKBUN_API_KEY=vagrant-not-a-key
PORKBUN_SECRET_KEY=vagrant-not-a-key
KAGENT_GRAFANA_TOKEN=vagrant-not-used
KAGENT_OAUTH_COOKIE_SECRET=vagrant-not-used-0123456789abcd
NVD_API_KEY=vagrant-not-a-key
RENOVATE_GITHUB_TOKEN=vagrant-not-a-token
RENOVATE_TOKEN=vagrant-not-a-token
WOODPECKER_CLONE_TOKEN=vagrant-not-a-token
WOODPECKER_FORGEJO_CLIENT=vagrant-not-used
WOODPECKER_FORGEJO_SECRET=vagrant-not-used
WOODPECKER_INFRA_REPO_TOKEN=vagrant-not-a-token
